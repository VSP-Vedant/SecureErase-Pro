# ─── DATABASE ────────────────────────────────────────────────────────────────
# PostgreSQL database name
POSTGRES_DB=secureerase

# PostgreSQL username
POSTGRES_USER=secureerase_user

# PostgreSQL password — REQUIRED, use a strong random value (e.g. openssl rand -hex 32)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM

# Full DSN used by the backend service
DATABASE_URL=postgresql://secureerase_user:CHANGE_ME_STRONG_RANDOM@postgres:5432/secureerase

# ─── REDIS ───────────────────────────────────────────────────────────────────
# Redis password — REQUIRED, use a strong random value
REDIS_PASSWORD=CHANGE_ME_STRONG_RANDOM

# Redis connection URL (used by backend for rate limiting + task queue)
REDIS_URL=redis://:CHANGE_ME_STRONG_RANDOM@redis:6379/0

# ─── APPLICATION SECURITY ────────────────────────────────────────────────────
# App secret key — REQUIRED, minimum 32 bytes random hex (openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_32_BYTE_HEX

# JWT signing secret — REQUIRED, minimum 32 bytes random hex
JWT_SECRET=CHANGE_ME_32_BYTE_HEX

# JWT access token expiry in minutes (default: 480 = 8 hours for enterprise tier)
JWT_EXPIRY_MINUTES=480

# ─── SIGNING KEYS ────────────────────────────────────────────────────────────
# Path inside the container to the PEM-encoded private signing key (read-only mount)
# Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out signing_key.pem
SIGNING_KEY_PATH=/run/secrets/signing_key.pem

# Path inside the container to the PEM-encoded public key
# Generate with: openssl rsa -pubout -in signing_key.pem -out signing_public.pem
PUBLIC_KEY_PATH=/run/secrets/signing_public.pem

# ─── PORTAL CONFIGURATION ────────────────────────────────────────────────────
# Public domain for the verification portal (no trailing slash)
PORTAL_DOMAIN=https://verify.yourdomain.com

# Allowed CORS origins (comma-separated). Must include frontend origin.
CORS_ORIGINS=https://verify.yourdomain.com

# API base URL exposed to the React frontend (injected at build time via Vite)
VITE_API_BASE_URL=https://verify.yourdomain.com/api/v1

# ─── EMAIL / NOTIFICATIONS (optional) ────────────────────────────────────────
# SMTP server hostname (optional — leave blank to disable email notifications)
SMTP_HOST=

# SMTP port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# SMTP username
SMTP_USER=

# SMTP password — treat as a secret
SMTP_PASSWORD=

# From address used for notification emails
NOTIFICATION_FROM_EMAIL=noreply@yourdomain.com

# ─── ADMIN ────────────────────────────────────────────────────────────────────
# Admin account email (created on first boot migration)
ADMIN_EMAIL=admin@yourdomain.com

# Admin initial password — REQUIRED, change immediately after first login
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

# ─── OBSERVABILITY ────────────────────────────────────────────────────────────
# Log level: debug | info | warning | error
LOG_LEVEL=info

# Sentry DSN for error tracking (optional — leave blank to disable)
SENTRY_DSN=
