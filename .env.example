# ============================================================
# SecureErase Pro — Environment Configuration
# Copy this file to .env and fill all required values.
# NEVER commit .env to version control.
# ============================================================

# ---- DATABASE --------------------------------------------------
# PostgreSQL database name
# Required | Format: alphanumeric string
POSTGRES_DB=secureerase

# PostgreSQL username
# Required | Format: alphanumeric string
POSTGRES_USER=secureerase_user

# PostgreSQL password
# REQUIRED — use a strong random value (min 32 chars)
# Security: HIGH — rotate every 90 days
POSTGRES_PASSWORD=

# Full database connection URL used by the backend
# Required | Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://secureerase_user:CHANGE_ME@postgres:5432/secureerase

# ---- REDIS -----------------------------------------------------
# Redis authentication password
# REQUIRED — use a strong random value (min 32 chars)
# Security: HIGH
REDIS_PASSWORD=

# Redis connection URL used by the backend
# Required | Format: redis://:password@host:port/db_index
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# ---- APPLICATION SECURITY -------------------------------------
# Django/FastAPI secret key for session signing
# REQUIRED — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Security: CRITICAL — never share or reuse
SECRET_KEY=

# JWT signing secret
# REQUIRED — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Security: CRITICAL
JWT_SECRET=

# JWT access token expiry in minutes
# Optional | Default: 480 (8 hours for enterprise tier)
JWT_EXPIRY_MINUTES=480

# ---- SIGNING KEYS ---------------------------------------------
# Path inside the container to the RSA-4096 or ECDSA-P384 private key PEM
# Required | The file must be mounted read-only via Docker volume
# Security: CRITICAL — never bake into image
SIGNING_KEY_PATH=/run/secrets/signing_key.pem

# Path inside the container to the corresponding public key PEM
# Required | Published at /api/v1/keys/{fingerprint}
PUBLIC_KEY_PATH=/run/secrets/public_key.pem

# ---- PORTAL CONFIGURATION ------------------------------------
# Public domain of the verification portal (no trailing slash)
# Required | Format: https://verify.yourdomain.com
PORTAL_DOMAIN=https://verify.yourdomain.com

# Comma-separated list of allowed CORS origins
# Required | Format: https://app.yourdomain.com,https://verify.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# API base URL used by the React frontend (Vite build-time variable)
# Required | Format: https://verify.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# ---- EMAIL / NOTIFICATIONS (OPTIONAL) ------------------------
# SMTP host for notification emails
# Optional
SMTP_HOST=

# SMTP port (587 for STARTTLS, 465 for SSL)
# Optional | Default: 587
SMTP_PORT=587

# SMTP username
# Optional
SMTP_USER=

# SMTP password
# Optional | Security: MEDIUM
SMTP_PASSWORD=

# From address for notification emails
# Optional | Format: SecureErase Pro <noreply@yourdomain.com>
NOTIFICATION_FROM_EMAIL=

# ---- ADMIN ----------------------------------------------------
# Initial admin account email (created on first run)
# Required
ADMIN_EMAIL=admin@yourdomain.com

# Initial admin password
# REQUIRED — change immediately after first login
# Security: CRITICAL
ADMIN_INITIAL_PASSWORD=

# ---- OBSERVABILITY -------------------------------------------
# Log level for backend services
# Optional | Values: debug | info | warning | error | Default: info
LOG_LEVEL=info

# Sentry DSN for error tracking
# Optional | Leave blank to disable
SENTRY_DSN=
